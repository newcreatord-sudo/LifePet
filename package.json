{
  "name": "trae-project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "firebase:deploy:functions": "npx firebase-tools deploy --only functions",
    "firebase:deploy:firestore": "npx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "firebase:deploy:all": "npx firebase-tools deploy --only firestore:rules,firestore:indexes,functions",
    "firebase:deploy:all:safe": "cross-env SKIP_AI=1 MS_ENABLE_SIMULATION=0 npx firebase-tools deploy --only firestore:rules,firestore:indexes,functions",
    "emulators:start": "firebase emulators:start --project demo-lifepet",
    "test:e2e:emulators": "npm --prefix functions run build && firebase emulators:exec --project demo-lifepet \"cross-env VITE_FIREBASE_EMULATORS=1 PLAYWRIGHT_PORT=5194 npm run test:e2e\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.3.0",
    "openai": "^4.91.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/leaflet": "^1.9.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^14.7.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
